<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.CAMERA" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

    <!-- required="false": the CAMERA permission alone implies this hardware
         is mandatory (Play Store would hide the app on devices/ChromeOS
         without a camera) unless stated otherwise. Capture is this app's
         core feature but gracefully no-ops without a camera result
         (TakePicture's callback just reports failure), so it isn't a hard
         device requirement at the manifest level. -->
    <uses-feature
        android:name="android.hardware.camera"
        android:required="false" />

    <!-- Required on API 30+ to resolve the system camera app via the
         implicit ACTION_IMAGE_CAPTURE intent (TakePicture contract). -->
    <queries>
        <intent>
            <action android:name="android.media.action.IMAGE_CAPTURE" />
        </intent>
    </queries>

    <application
        android:name=".AiFinancialApp"
        android:allowBackup="false"
        android:label="@string/app_name"
        android:theme="@style/Theme.AiFinancialMobile"
        android:supportsRtl="true">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:theme="@style/Theme.AiFinancialMobile">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>

    </application>

</manifest>
